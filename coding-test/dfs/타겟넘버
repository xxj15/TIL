def solution(numbers, target):
    answer = 0
    
    def dfs(i, num):
        nonlocal answer
        if i == len(numbers):
            if num == target:
                answer += 1
            return
        
        dfs(i+1, num + numbers[i])
        dfs(i+1, num - numbers[i])
    
    dfs(0, 0)  
    return answer